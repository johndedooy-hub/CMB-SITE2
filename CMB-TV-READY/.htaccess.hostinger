# CMB fresh-server defaults. Keep video byte-range requests enabled (Apache default).
AddType video/mp4 .mp4 .m4v
AddType video/webm .webm
AddType video/ogg .ogv
AddType video/quicktime .mov
AddType video/x-matroska .mkv
AddType application/vnd.apple.mpegurl .m3u8
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
</IfModule>

# =======================================================
# VERBERG .PHP EXTENSIE (Toegevoegd)
# =======================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Verwijder de .php extensie uit de URL via een redirect (alleen bij gewoon bekijken)
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
  RewriteRule ^ %1 [R=301,L]

  # 2. Zorg dat de pagina intern nog wel als PHP wordt ingeladen
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.*)$ $1.php [L]
</IfModule>